# Manual development configuration. For guided installation use npm run setup.
# Copy to .env; empty required values fail startup. Generate independent secrets.
DATABASE_URL=
FILES_KEY=
ADMIN_LOGIN=owner
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
TLS_CERT=
TLS_KEY=
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,null
LOG_LEVEL=info

# Enable only behind exactly one private reverse proxy with no direct API port.
SINGLE_PRIVATE_PROXY=false
