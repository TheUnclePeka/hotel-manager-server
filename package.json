{
  "name": "@hotel-manager/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/dev.ts",
    "build": "tsc -b && node scripts/copy-migrations.mjs",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "test:security": "node scripts/test-security.mjs",
    "setup": "node scripts/setup.mjs",
    "test:installer": "node --test tests/deployment.test.mjs tests/setup.test.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "notices": "node scripts/third-party.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hotel-manager/shared": "file:vendor/hotel-manager-shared-0.2.0.tgz",
    "@node-rs/argon2": "^2.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.0.15",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "selfsigned": "5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "description": "Hotel Manager \u0432\u0402\u201d server",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
